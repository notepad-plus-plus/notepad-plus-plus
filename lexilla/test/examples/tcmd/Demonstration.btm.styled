{2}endiff{0}

{2}set{0} file{7}={6}%1{0}

{2}iff{0} {8}%file{2} then{0}
  grep "local" {8}%file{0}
{2}else{0}
  {2}echo{0} No file {9}!file!{0}.
{2}endiff{0}

{3}:end
